# ---------------------------------------------------------------------------
# Aceso configuration — copy this file to `.env` and fill in your own values.
# Never commit `.env`.
# ---------------------------------------------------------------------------

# --- LLM provider selection --------------------------------------------------
# Primary provider used for every request. One of: groq | gemini | openrouter | openai
LLM_PROVIDER=groq
# Comma-separated, tried in order when the primary fails/times out.
# Leave empty to disable fallback entirely.
LLM_FALLBACK_PROVIDERS=gemini,openrouter

# --- Groq (https://console.groq.com/keys) — very low-latency inference -----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini (free tier available at https://aistudio.google.com/apikey) -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter (free models available at https://openrouter.ai/models) -----
OPENROUTER_API_KEY=
# Comma-separated list of model slugs, tried in order.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- OpenAI (optional — NOT required for the app to function) ---------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LLM sampling defaults (used unless overridden per-request) -------------
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
LLM_FREQUENCY_PENALTY=0

# --- LLM latency / retry behavior --------------------------------------------
LLM_TIMEOUT_SECONDS=6
LLM_RETRY_BACKOFF_SECONDS=0.5

# --- Auth (JWT) ---------------------------------------------------------
# Required — no safe default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Email (SMTP) — appointment confirmations only, best-effort -------------
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled first) and use it as SMTP_PASSWORD —
# never your real account password.
# Leave SMTP_USERNAME/SMTP_PASSWORD blank to disable email sending (booking
# still works; the send is skipped and logged).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Database -----------------------------------------------------------
# When running via docker compose this is set automatically to the
# `postgres` service. Override for local (non-docker) development.
DATABASE_URL=postgresql+psycopg2://aceso:aceso@localhost:5432/aceso

# --- Misc ---------------------------------------------------------------
# CORS origins allowed to call the API (comma separated). "*" for dev.
CORS_ORIGINS=*
LOG_LEVEL=INFO
